PICTOFLOW_ENVIRONMENT=development
PICTOFLOW_APP_NAME=PictoFlow
PICTOFLOW_DEBUG=false

# Optional until persistence is used. Use a local development database.
# PICTOFLOW_DATABASE_URL=postgresql+psycopg://pictoflow:local-password@127.0.0.1:5432/pictoflow

# Leave unset for explicit no-Redis mode. Credentials, when needed, stay server-side.
# PICTOFLOW_REDIS_URL=redis://127.0.0.1:6379/0
PICTOFLOW_REDIS_TIMEOUT_SECONDS=0.5

# AI remains optional; disabled/fake require no external service.
PICTOFLOW_AI_PROVIDER=disabled
# In fake mode, unset uses bundled sample fixtures; otherwise use an absolute JSON path.
# PICTOFLOW_FAKE_PROVIDER_FIXTURES=C:/path/to/local-fixtures.json
# Optional modes: openai-compatible or prism. Keep all credentials server-side.
# PICTOFLOW_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
# PICTOFLOW_PROVIDER_MODEL=your-model-id
# PICTOFLOW_PROVIDER_API_KEY=
PICTOFLOW_PROVIDER_TIMEOUT_SECONDS=30
# PICTOFLOW_PRISM_CAPABILITIES=["interpret","simplify"]
PICTOFLOW_CONFIDENCE_REFUSAL=0.40
PICTOFLOW_CONFIDENCE_CONFIRMATION=0.65
PICTOFLOW_CONFIDENCE_DIRECT=0.90
PICTOFLOW_GAP_MINIMUM_OCCURRENCES=5
PICTOFLOW_GAP_MINIMUM_VALIDATED=4
PICTOFLOW_OBSERVABILITY_ENABLED=false

# Docker Compose local development only. init_env.py fills this password without printing it.
POSTGRES_USER=pictoflow
POSTGRES_DB=pictoflow
POSTGRES_PASSWORD=
PICTOFLOW_BACKEND_PORT=8000
