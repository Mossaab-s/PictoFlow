{
  "name": "pictoflow-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests package.json tsconfig.json next.config.ts",
    "format:check": "prettier --check src tests package.json tsconfig.json next.config.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
